# Copy this file to .apple-credentials/credentials.env and fill in the values from
# App Store Connect > Users and Access > Integrations > Team Keys.
# Never commit the downloaded .p8 private key.

EXPO_ASC_API_KEY_PATH="./.apple-credentials/AuthKey_XXXXXXXXXX.p8"
EXPO_ASC_KEY_ID="XXXXXXXXXX"
EXPO_ASC_ISSUER_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
EXPO_APPLE_TEAM_ID="XXXXXXXXXX"
EXPO_APPLE_TEAM_TYPE="INDIVIDUAL"
